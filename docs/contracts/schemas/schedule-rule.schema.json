{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberkindred://contracts/v1/schedule-rule.schema.json",
  "title": "ScheduleRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scheduleId", "name", "timezone", "daysOfWeek", "localTime", "enabled", "notificationOnly", "createdAt", "updatedAt", "revision"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scheduleId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "timezone": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+-]+)+$" },
    "daysOfWeek": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
    },
    "localTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "enabled": { "type": "boolean" },
    "notificationOnly": { "const": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 }
  }
}
