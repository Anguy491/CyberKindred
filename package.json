{
  "name": "cyberkindred",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "tauri": "tauri",
    "contracts:generate": "node scripts/generate-contracts.mjs --write",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:axe": "vitest run tests/ui/app-shell-accessibility.test.tsx",
    "test:contracts": "pnpm contracts:check && vitest run tests/contracts/schema-contract.test.ts",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:self": "node --test tests/e2e/*.test.mjs",
    "test:m7:guards": "cargo test --release --package cyberkindred --test m7_engineering_guards -- --ignored --nocapture",
    "test:visual": "vitest run tests/ui/visual-policy.test.ts",
    "coverage:rust": "cargo llvm-cov --workspace --all-features --branch --json --output-path target/m7-evidence/rust-coverage.json",
    "coverage:gate": "node scripts/m7/merge-coverage.mjs --typescript coverage/coverage-summary.json --rust target/m7-evidence/rust-coverage.json --min-lines 80 --min-branches 70 --output target/m7-evidence/coverage-summary.json",
    "verify:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-docs.ps1",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:assets": "node scripts/release/generate-release-assets.mjs",
    "release:verify-assets": "node scripts/release/verify-release-assets.mjs",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-beta.ps1",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify-release.ps1",
    "release:repro": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/test-reproducibility.ps1",
    "release:test-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/test-installer.ps1",
    "check": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:e2e:self && pnpm build && pnpm verify:docs",
    "verify": "pnpm release:verify && pnpm coverage:rust && pnpm coverage:gate"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-notification": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "oxlint": "1.81.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
