{
  "name": "cyberkindred",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "tauri": "tauri",
    "contracts:generate": "node scripts/generate-contracts.mjs --write",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:contracts": "pnpm contracts:check && vitest run tests/contracts/schema-contract.test.ts",
    "test:coverage": "vitest run --coverage",
    "verify:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-docs.ps1",
    "check": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm verify:docs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "@tauri-apps/cli": "2.11.4"
  }
}
